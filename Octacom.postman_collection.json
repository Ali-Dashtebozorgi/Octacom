    {
      "name": "Waitlist Flow",
      "item": [
        {
          "name": "1. Book Seat - Fills Conference (Confirmed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Booking is Confirmed', function () {",
                  "    pm.expect(body.data.status).to.eql('Confirmed');",
                  "});",
                  "pm.collectionVariables.set('bookingId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendeeName\": \"First Attendee\",\n  \"attendeeEmail\": \"first@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conferences/{{fullConferenceId}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences", "{{fullConferenceId}}", "bookings"]
            }
          },
          "description": "Run this against the 1-seat 'Small Workshop' conference created earlier."
        },
        {
          "name": "2. Book Seat - Conference Full (Waitlisted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 (waitlisted, not rejected)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Booking is Waitlisted', function () {",
                  "    pm.expect(body.data.status).to.eql('Waitlisted');",
                  "});",
                  "pm.collectionVariables.set('waitlistedBookingId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendeeName\": \"Second Attendee\",\n  \"attendeeEmail\": \"second@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conferences/{{fullConferenceId}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences", "{{fullConferenceId}}", "bookings"]
            }
          }
        },
        {
          "name": "3. Cancel First Booking - Triggers Promotion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/conferences/{{fullConferenceId}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences", "{{fullConferenceId}}", "bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "4. Verify Waitlisted Booking Was Promoted",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Booking is now Confirmed', function () {",
                  "    pm.expect(body.data.status).to.eql('Confirmed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conferences/{{fullConferenceId}}/bookings/{{waitlistedBookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences", "{{fullConferenceId}}", "bookings", "{{waitlistedBookingId}}"]
            }
