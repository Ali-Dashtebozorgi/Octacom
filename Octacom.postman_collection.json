  "item": [
    {
      "name": "Conferences",
      "item": [
        {
          "name": "Create Conference - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Has Location header', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Response is success and has data', function () {",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.id).to.not.be.empty;",
                  "    pm.expect(body.data.availableSeats).to.eql(50);",
                  "});",
                  "pm.collectionVariables.set('conferenceId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech Summit 2026\",\n  \"totalCapacity\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences"]
            }
          }
        },
        {
