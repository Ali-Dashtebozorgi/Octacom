        {
          "name": "Get All Conferences (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has paged structure', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.data).to.have.property('items');",
                  "    pm.expect(body.data).to.have.property('totalCount');",
                  "    pm.expect(body.data).to.have.property('page');",
                  "    pm.expect(body.data).to.have.property('pageSize');",
                  "    pm.expect(body.data).to.have.property('totalPages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conferences?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conferences"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Conference By Id - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
